# Proteger archivos sensibles
<FilesMatch "^(config\.php|config\.example\.php|conversations\.json|.*\.log)$">
    Require all denied
</FilesMatch>

# Bloquear acceso a la carpeta de cache
# (los logs ya no viven acá — ver /logs/whatsapp/, protegida por /logs/.htaccess)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^cache/ - [F,L]
</IfModule>
