# 1. Kill 'smart' matching (Crucial for preventing the /room/ 404 error)
Options -MultiViews -Indexes
RewriteEngine On
RewriteBase /

# 2. Fix the /admin folder specifically
# If someone goes to /admin, force it to load /admin/index.php
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.php -f
RewriteRule ^admin/?$ admin/index.php [L]

# 3. Remove .php extension from URLs (External Redirect)
# Excluir whatsapp/ y los endpoints que reciben POST con body — un 301 los
# redirige a GET, perdiendo el body (el navegador no reenvía el POST).
# OJO: cuando la regla 4b reescribe /cafeteriagatonegro/x.php -> cafeteria/x.php,
# mod_rewrite reinicia el procesamiento del .htaccess desde el principio con la
# nueva URI interna. Por eso hay que excluir TAMBIÉN /cafeteria/ (la carpeta real),
# no solo /cafeteriagatonegro/ (la URL pública) — si no, esta regla agarra la URI
# ya reescrita en esa segunda pasada y la vuelve a redirigir, perdiendo el POST.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.php
RewriteCond %{REQUEST_URI} !^/whatsapp/
RewriteCond %{REQUEST_URI} !^/payway_charge\.php$
RewriteCond %{REQUEST_URI} !^/paypal_create_order\.php$
RewriteCond %{REQUEST_URI} !^/paypal_capture_order\.php$
RewriteCond %{REQUEST_URI} !^/cafeteriagatonegro/
RewriteCond %{REQUEST_URI} !^/cafeteria/
RewriteRule ^/?(.*)\.php$ /$1 [L,R=301]

# 4. Map the dynamic Room URLs (MUST be placed before the generic .php rule)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^room/([^/]+)/?$ room.php?name=$1 [L,QSA]

# 4b. Cafetería Gato Negro — carpeta real es /cafeteria, URL pública /cafeteriagatonegro
RewriteRule ^cafeteriagatonegro/open_comanda\.php$ cafeteria/open_comanda.php [L,QSA]
RewriteRule ^cafeteriagatonegro/add_item\.php$ cafeteria/add_item.php [L,QSA]
RewriteRule ^cafeteriagatonegro/remove_item\.php$ cafeteria/remove_item.php [L,QSA]
RewriteRule ^cafeteriagatonegro/cancel_comanda\.php$ cafeteria/cancel_comanda.php [L,QSA]
RewriteRule ^cafeteriagatonegro/close_comanda\.php$ cafeteria/close_comanda.php [L,QSA]
RewriteRule ^cafeteriagatonegro/update_stock\.php$ cafeteria/update_stock.php [L,QSA]
RewriteRule ^cafeteriagatonegro/update_ingredient\.php$ cafeteria/update_ingredient.php [L,QSA]
RewriteRule ^cafeteriagatonegro/add_purchase\.php$ cafeteria/add_purchase.php [L,QSA]
RewriteRule ^cafeteriagatonegro/create_product\.php$ cafeteria/create_product.php [L,QSA]
RewriteRule ^cafeteriagatonegro/create_ingredient\.php$ cafeteria/create_ingredient.php [L,QSA]
RewriteRule ^cafeteriagatonegro/update_price\.php$ cafeteria/update_price.php [L,QSA]
RewriteRule ^cafeteriagatonegro/delete_product\.php$ cafeteria/delete_product.php [L,QSA]
RewriteRule ^cafeteriagatonegro/delete_ingredient\.php$ cafeteria/delete_ingredient.php [L,QSA]
RewriteRule ^cafeteriagatonegro/update_flags\.php$ cafeteria/update_flags.php [L,QSA]
RewriteRule ^cafeteriagatonegro/update_recipe\.php$ cafeteria/update_recipe.php [L,QSA]
RewriteRule ^cafeteriagatonegro/produce_product\.php$ cafeteria/produce_product.php [L,QSA]
RewriteRule ^cafeteriagatonegro/stock/?$ cafeteria/stock.php [L,QSA]
RewriteRule ^cafeteriagatonegro/costos/?$ cafeteria/costos.php [L,QSA]
RewriteRule ^cafeteriagatonegro/reportes/?$ cafeteria/reportes.php [L,QSA]
RewriteRule ^cafeteriagatonegro/insumos/?$ cafeteria/insumos.php [L,QSA]
RewriteRule ^cafeteriagatonegro/login/?$ cafeteria/login.php [L,QSA]
RewriteRule ^cafeteriagatonegro/logout/?$ cafeteria/logout.php [L,QSA]
RewriteRule ^cafeteriagatonegro/?$ cafeteria/index.php [L,QSA]

# 5. Map clean URLs back to .php files (Internal Routing)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]

# 6. Default index
DirectoryIndex index.php